# Configuration d'environnement pour Drupal

# Base de données
DB_HOST=mysql
DB_PORT=3306
DB_HOST_PORT=3307
DB_NAME=drupal
DB_USER=drupal
DB_PASSWORD=drupal_password_change_me
DB_ROOT_PASSWORD=root_password_change_me

# Drupal
DRUPAL_ENV=develop
DRUPAL_HASH_SALT=change_me_to_random_string
DRUPAL_HOST=localhost:8080

# Mail
MAIL_HOST=mailhog
MAIL_PORT=1025

# Redis (optionnel)
REDIS_HOST=redis
REDIS_PORT=6379

# Jenkins
JENKINS_PORT=8084
JENKINS_AGENTS_PORT=50000

# Paths
DRUPAL_ROOT=/var/www/html
DRUPAL_FILES_PATH=/var/www/html/web/sites/default/files
DRUPAL_CONFIG_PATH=/var/www/html/config

# Drush
DRUSH_OPTIONS_URI=http://localhost:8080
DRUSH_OPTIONS_PIPE=1
